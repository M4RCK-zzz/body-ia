# Copiar a .env (NO versionar .env)
POSTGRES_DB=bodyvision
POSTGRES_USER=bodyvision
# Usa solo letras y números en local: la contraseña se reutiliza dentro de una URL
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# Solo si usas: docker compose --profile tools up -d
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-this-local-password
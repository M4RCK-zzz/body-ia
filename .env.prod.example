# ============================================================================
# Plantilla de producción BODYVISION AI (Fase 9).
# Copiar a `.env.prod` (NUNCA versionar: `.gitignore` ya lo excluye) y rellenar.
#
# Un `.env.prod` con valores de ejemplo hace que la API **no arranque** en
# producción (ver `Settings._production_guards`). Es intencionado.
# ============================================================================

# --- Identidad del despliegue ----------------------------------------------
# Nombre que la API devuelve en `/api/health` y en la documentación.
APP_NAME=BODYVISION AI
APP_VERSION=0.1.0
DOMAIN=bodyvision.example.com
# TLS: los certificados se leen de `docker/nginx/certs/` (fullchain.pem + privkey.pem).
#   - Let's Encrypt: copia/engancha /etc/letsencrypt/live/$DOMAIN/ en esa carpeta.
#   - Certificado corporativo: deja ahí los dos ficheros.
#   - Pruebas locales: `scripts/tls-selfsigned.ps1` (o .sh) y ALLOW_SELFSIGNED=true.
# ALLOW_SELFSIGNED=true genera un autofirmado al arrancar si faltan los ficheros.
# NUNCA en producción real.
ALLOW_SELFSIGNED=false

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=bodyvision
POSTGRES_USER=bodyvision
# Genera una contraseña larga y alfanumérica:
#   python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(40)))"
POSTGRES_PASSWORD=CAMBIA-ESTA-CONTRASENA

# --- API -------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
# Vacío = URLs relativas (mismo origen a través de Nginx). Ver decisión D9.
VITE_API_URL=
# Debe ser https:// y el dominio real. Sin comodines, sin http.
CORS_ORIGINS=https://bodyvision.example.com
# `true` solo porque la API no se publica y todo entra por Nginx, que reescribe
# `X-Real-IP` con la IP real de la conexión. El límite por IP se calcula con esa
# cabecera; con `false` se usaría la IP del contenedor de Nginx (todos iguales).
TRUSTED_PROXIES=true
ENABLE_API_DOCS=false
# Cabeceras de seguridad y HSTS (solo se envían con TLS real y fuera de `local`).
SECURITY_HEADERS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# Secreto de firma JWT: mínimo 32 caracteres y nunca el valor de ejemplo.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIA-ESTE-SECRETO-POR-UNA-CADENA-ALEATORIA-DE-48-CARACTERES
JWT_ALGORITHM=HS256
JWT_ISSUER=bodyvision
ACCESS_TOKEN_MINUTES=30
# En producción el registro público suele estar cerrado (usuarios por admin).
ALLOW_REGISTRATION=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_HOUR=20
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_WORKER_TRIGGER_PER_HOUR=60
RATE_LIMIT_DOWNLOAD_PER_HOUR=120

# --- Observabilidad --------------------------------------------------------
# Un worker sin latido durante este tiempo se considera caído. Solo se evalúa
# sobre los workers continuos (pose, report, simulation): `retention` es one-shot
# y su último latido se informa sin degradar `/api/health/workers`.
WORKER_STALE_SECONDS=120

# --- Datos -----------------------------------------------------------------
# `DATABASE_URL` no se define aquí: Compose la compone con POSTGRES_* y la URL del
# servicio `db`. Si se usa fuera de Compose, hay que definirla a mano.
UPLOAD_DIR=/app/storage
MAX_UPLOAD_MB=10
MEDIA_RETENTION_DAYS=365
MEDIA_MAX_PIXELS=25000000

# --- Workers ---------------------------------------------------------------
POSE_MODEL_PATH=/app/models/pose_landmarker_full.task
POSE_POLL_SECONDS=5
POSE_STALE_PROCESSING_SECONDS=1800
POSE_COMPLETE_THRESHOLD=25
POSE_REVIEW_THRESHOLD=10
POSE_VISIBILITY_THRESHOLD=0.5
REPORT_POLL_SECONDS=5
REPORT_STALE_PROCESSING_SECONDS=1800
SIMULATION_MAX_DELTA_PERCENT=30
SIMULATION_POLL_SECONDS=5
SIMULATION_STALE_PROCESSING_SECONDS=1800
SIMULATION_MAX_ACTIVE_PER_PROFILE=20

# --- Retención y purga (Fase 9) --------------------------------------------
# true por defecto: la purga solo informa hasta que se revisa a mano.
RETENTION_DRY_RUN=true
REPORT_RETENTION_DAYS=365
SIMULATION_RETENTION_DAYS=365

# --- Retención y purga (Fase 9) --------------------------------------------
# El servicio `retention` corre una pasada (`--once`). `RETENTION_DRY_RUN=true`
# solo informa de lo que borraría; `run --rm retention --apply` lo fuerza.
RETENTION_DRY_RUN=true
RETENTION_POLL_SECONDS=0.5
REPORT_RETENTION_DAYS=365
SIMULATION_RETENTION_DAYS=365

# --- Backups ---------------------------------------------------------------
# Directorios de backup que conserva `backup.sh` antes de rotar (1 = solo el último).
BACKUP_KEEP=7

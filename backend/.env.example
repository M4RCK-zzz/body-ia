# Plantilla de desarrollo del backend. Copiar a `backend/.env` (no se versiona).
# Toda variable de `app/core/config.py` está aquí; el despliegue de producción usa
# `.env.prod.example` (raíz), que es la que consume Docker Compose.

# --- Identidad del servicio ---
APP_NAME=BODYVISION AI
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
SECURITY_HEADERS=true

DATABASE_URL=postgresql+psycopg://bodyvision:change-this-local-password@localhost:5432/bodyvision

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Dominio público del despliegue (Nginx lo recibe como ${DOMAIN}).
DOMAIN=localhost
# Documentación interactiva (`/api/docs`, `/api/redoc`, `/api/openapi.json`).
# En `production` se fuerza a false (guard de arranque).
ENABLE_API_DOCS=true
# HSTS: solo se envía con SECURITY_HEADERS=true y fuera de `local`.
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
# `true` solo detrás de Nginx: la IP del límite sale de `X-Real-IP`, que el proxy
# reescribe. Con `false` (default) se usa la IP de la conexión TCP.
TRUSTED_PROXIES=false

UPLOAD_DIR=./storage
MAX_UPLOAD_MB=10

# --- Captura segura (Fase 4) ---
MEDIA_RETENTION_DAYS=365
MEDIA_MAX_PIXELS=25000000

# --- Análisis de pose (Fase 5) ---
# Modelo oficial MediaPipe (ver README: descarga pose_landmarker_full.task)
POSE_MODEL_PATH=./models/pose_landmarker_full.task
POSE_POLL_SECONDS=5
POSE_STALE_PROCESSING_SECONDS=1800
POSE_COMPLETE_THRESHOLD=25
POSE_REVIEW_THRESHOLD=10
POSE_VISIBILITY_THRESHOLD=0.5

# --- Reportes (Fase 7) ---
# El worker de reportes genera CSV/PDF en el storage privado (no en PostgreSQL).
REPORT_POLL_SECONDS=5
REPORT_STALE_PROCESSING_SECONDS=1800

# --- Identidad y sesión (Fase 3) ---
JWT_SECRET=change-me-generate-a-random-value-of-48-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=bodyvision
ACCESS_TOKEN_MINUTES=30
ALLOW_REGISTRATION=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Simulación de escenarios hipotéticos (Fase 8) ---
# Tope de cambio por métrica (30% recomendado; rango 5-50) y límite de escenarios
# activos por expediente. El motor es determinista: cambiar el tope cambia la
# configuración registrada en engine_config, no resultados ya calculados.
SIMULATION_MAX_DELTA_PERCENT=30
SIMULATION_POLL_SECONDS=5
SIMULATION_STALE_PROCESSING_SECONDS=1800
SIMULATION_MAX_ACTIVE_PER_PROFILE=20

# --- Rate limiting (Fase 9) ---
# Techo global por IP y reglas por endpoint. `/api/health*` y `/api/docs` nunca
# se limitan. Con varias réplicas el límite efectivo es N× (limitación aceptada).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_HOUR=20
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_WORKER_TRIGGER_PER_HOUR=60
RATE_LIMIT_DOWNLOAD_PER_HOUR=120

# --- Retención y purga (Fase 9) ---
# Una pasada con `--once` (cron o a mano). `RETENTION_DRY_RUN=true` solo informa.
REPORT_RETENTION_DAYS=365
SIMULATION_RETENTION_DAYS=365
RETENTION_DRY_RUN=true
RETENTION_POLL_SECONDS=0.5
# Un worker sin latido durante este tiempo se considera caído (se evalúa solo
# sobre los workers continuos: pose, report y simulation; retention es one-shot).
WORKER_STALE_SECONDS=120
